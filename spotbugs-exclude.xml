<?xml version="1.0"?>
<FindBugsFilter>
  <Match>
    <!-- False positives for Logback -->
    <Bug pattern="CRLF_INJECTION_LOGS"/>
  </Match>
  <Match>
    <!-- Platform-specific classes may use OS-specific APIs -->
    <Class name="~com\.fatico\.winthing\.platform\.windows\..*"/>
    <Bug pattern="COMMAND_INJECTION"/>
  </Match>
  <Match>
    <!-- Shell commands in Linux/Mac services are intentional -->
    <Class name="~com\.fatico\.winthing\.platform\.(linux|mac)\..*"/>
    <Bug pattern="COMMAND_INJECTION"/>
  </Match>
  <Match>
    <!-- ShellExecutor runs commands by design -->
    <Class name="com.fatico.winthing.platform.ShellExecutor"/>
    <Bug pattern="COMMAND_INJECTION"/>
  </Match>

  <!-- Guice DI controllers register handlers in constructor - architectural pattern -->
  <Match>
    <Bug pattern="MC_OVERRIDABLE_METHOD_CALL_IN_CONSTRUCTOR"/>
  </Match>

  <!-- Controllers store injected services - standard DI pattern, not external input -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>

  <!-- Constructors throw to signal invalid configuration - intentional fail-fast -->
  <Match>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>

  <!-- Paths read from trusted config files, not raw user HTTP input -->
  <Match>
    <Bug pattern="PATH_TRAVERSAL_IN"/>
  </Match>

  <!-- /proc and /sys are well-known Linux kernel virtual filesystems -->
  <Match>
    <Bug pattern="DMI_HARDCODED_ABSOLUTE_FILENAME"/>
  </Match>

  <!-- JNA structure fields are populated by native memory - SpotBugs cannot see this -->
  <Match>
    <Class name="~com\.fatico\.winthing\.windows\.jna\..*"/>
    <Bug pattern="UUF_UNUSED_PUBLIC_OR_PROTECTED_FIELD"/>
  </Match>
  <Match>
    <Class name="~com\.fatico\.winthing\.windows\.jna\..*"/>
    <Bug pattern="UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD"/>
  </Match>
  <Match>
    <Class name="com.fatico.winthing.platform.windows.WindowsMonitoringService"/>
    <Bug pattern="UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD"/>
  </Match>

  <!-- Static throttle field shared intentionally across ConsoleLogger instances -->
  <Match>
    <Class name="com.fatico.winthing.logging.ConsoleLogger"/>
    <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
  </Match>

  <!-- Broad Exception catch in I/O and network code is intentional for resilience -->
  <Match>
    <Bug pattern="REC_CATCH_EXCEPTION"/>
  </Match>

  <!-- Application.getApp() is an intentional singleton accessor -->
  <Match>
    <Class name="com.fatico.winthing.Application"/>
    <Bug pattern="MS_EXPOSE_REP"/>
  </Match>

  <!-- Static logger field is initialised by LoggerFactory, not in constructor -->
  <Match>
    <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
  </Match>

  <!-- Engine uses username from config for MQTT auth - locale normalisation is correct -->
  <Match>
    <Class name="com.fatico.winthing.messaging.Engine"/>
    <Bug pattern="IMPROPER_UNICODE"/>
  </Match>
  <Match>
    <Class name="com.fatico.winthing.platform.linux.LinuxMonitoringService"/>
    <Bug pattern="IMPROPER_UNICODE"/>
  </Match>
  <Match>
    <Class name="com.fatico.winthing.platform.windows.WindowsMonitoringService"/>
    <Bug pattern="IMPROPER_UNICODE"/>
  </Match>

  <!-- Redundant null check on ShellExecutor output is defensive and harmless -->
  <Match>
    <Class name="com.fatico.winthing.platform.linux.LinuxMonitoringService"/>
    <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
  </Match>
</FindBugsFilter>
